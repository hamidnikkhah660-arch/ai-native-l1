# QFP6 zero-value Public Testnet node image.
# Per-node private keys are supplied only through Railway service-scoped secrets.
FROM rust:1-bookworm AS builder
WORKDIR /src
COPY . .
WORKDIR /src/src/native/pow_bench
RUN cargo build --release --locked --bin qrun_v06_node

FROM debian:bookworm-slim AS runtime
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates python3 util-linux libgcc-s1 \
    && rm -rf /var/lib/apt/lists/*
RUN useradd --system --uid 10001 --home-dir /data --no-create-home qfp6 \
    && mkdir -p /app/assets /data \
    && chown qfp6:qfp6 /data
COPY --from=builder /src/src/native/pow_bench/target/release/qrun_v06_node /usr/local/bin/qrun_v06_node
COPY release/qfp6-candidate/artifacts/ /app/assets/
COPY deploy/railway/qfp6-node/entrypoint.py /app/entrypoint.py
COPY deploy/railway/qfp6-node/docker-entrypoint.sh /usr/local/bin/qfp6-docker-entrypoint
RUN chmod 0755 /usr/local/bin/qrun_v06_node /usr/local/bin/qfp6-docker-entrypoint \
    && chmod 0644 /app/entrypoint.py \
    && chown -R root:root /app
WORKDIR /app
EXPOSE 31000/tcp
ENTRYPOINT ["/usr/local/bin/qfp6-docker-entrypoint"]
